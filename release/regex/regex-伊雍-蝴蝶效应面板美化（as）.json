  "replaceString": "<section class=\"eybf-wrap\" data-eyon-butterfly=\"1\"><article class=\"eybf-card\"><header class=\"eybf-head\"><div class=\"eybf-heading\"><span class=\"eybf-kicker\">CAUSAL ARCHIVE · EYON</span><h2>蝴蝶效应</h2><p>一缕偏差，沿时间留下回声</p></div></header><div class=\"eybf-meta\"><div class=\"eybf-meta-cell\"><span>波及范围</span><strong>$2</strong></div></div><div class=\"eybf-flow\"><section class=\"eybf-record eybf-action\"><b>01</b><div><h3>墟境行动记录</h3><p>$5</p></div></section><div class=\"eybf-pair\"><section class=\"eybf-record\"><b>02</b><div><h3>现世落点</h3><p>$3</p></div></section><section class=\"eybf-record\"><b>03</b><div><h3>可感知证据</h3><p>$4</p></div></section></div><section class=\"eybf-record eybf-history\"><b>04</b><div><h3>历史演变</h3><p>$6</p></div></section></div><section class=\"eybf-keywords\"><span>历史关键词</span><p>$7</p></section><footer class=\"eybf-foot\"><i></i><span>伊雍见证 · 因果锚定</span></footer><div class=\"eybf-trim\" aria-hidden=\"true\"><i class=\"eybf-sigil eybf-sigil-tr\"></i><i class=\"eybf-sigil eybf-sigil-bl\"></i><i class=\"eybf-notch eybf-notch-tl\"></i><i class=\"eybf-notch eybf-notch-br\"></i></div></article></section><style>.mes .eybf-card,.swipe_right .eybf-card,.swipe_left .eybf-card{margin-left:0!important;margin-right:0!important}.eybf-wrap{position:relative;clear:both;margin:16px 0;display:flex;justify-content:center;isolation:isolate}.eybf-card{--plum:#9a61bb;--plum-deep:#392047;--ink:#f8f1fb;--muted:#c5b3cd;position:relative;overflow:hidden;isolation:isolate;width:min(94%,780px);box-sizing:border-box;padding:22px 24px 18px;color:var(--ink);font-family:'Noto Serif SC','Source Han Serif SC','Songti SC','SimSun',serif;border:1px solid rgba(190,148,210,.34);border-radius:26px 12px 28px 14px/22px 15px 25px 16px;background:repeating-linear-gradient(105deg,transparent 0 30px,rgba(255,255,255,.011) 31px 32px),radial-gradient(circle at 86% 0%,rgba(154,97,187,.15),transparent 28%),linear-gradient(160deg,#25142f 0%,#1b1025 58%,#140c1d 100%);box-shadow:0 16px 38px rgba(3,1,8,.42),inset 0 0 0 1px rgba(255,255,255,.025)}.eybf-card::before{content:\"\";position:absolute;inset:9px;border:1px solid rgba(220,194,231,.08);border-radius:20px 8px 22px 10px/17px 11px 19px 12px;pointer-events:none}.eybf-card::after{content:\"\";position:absolute;right:17px;bottom:15px;width:4px;height:4px;border:1px solid rgba(222,187,235,.42);transform:rotate(45deg);box-shadow:9px -9px 0 -1px rgba(163,104,185,.28);pointer-events:none}.eybf-head{position:relative;z-index:2;display:flex;align-items:center;justify-content:space-between;gap:18px;min-height:68px;padding:4px 5px 16px;border-bottom:1px solid rgba(195,170,207,.2)}.eybf-kicker{display:block;margin-bottom:5px;color:#cda9dd;font:600 10px/1.2 Georgia,'Times New Roman',serif;letter-spacing:.24em}.eybf-heading h2{margin:0;color:#fff8ff;font-size:27px;line-height:1.15;font-weight:650;letter-spacing:.12em}.eybf-heading p{margin:6px 0 0;color:var(--muted);font-size:12px;line-height:1.5;letter-spacing:.08em}.eybf-meta{position:relative;z-index:2;display:grid;grid-template-columns:minmax(0,1fr);gap:10px;margin:13px 0 11px}.eybf-meta-cell{display:flex;align-items:center;justify-content:space-between;gap:12px;min-width:0;padding:9px 12px;border:1px solid rgba(185,141,204,.18);border-radius:12px;background:rgba(255,255,255,.025)}.eybf-meta-cell span{color:#bca7c6;font-size:11px;letter-spacing:.12em;white-space:nowrap}.eybf-meta-cell strong{min-width:0;color:#f3dff9;font-size:14px;font-weight:650;text-align:right;word-break:break-word}.eybf-flow{position:relative;z-index:2;display:grid;gap:10px}.eybf-pair{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.eybf-record{position:relative;display:grid;grid-template-columns:29px minmax(0,1fr);gap:10px;padding:12px 13px;border:1px solid rgba(185,141,204,.18);border-radius:13px;background:linear-gradient(180deg,rgba(255,255,255,.035),rgba(255,255,255,.015))}.eybf-record::after{content:\"\";position:absolute;left:15px;top:43px;bottom:12px;width:1px;background:linear-gradient(var(--plum),transparent);opacity:.35}.eybf-record b{display:grid;place-items:center;width:25px;height:25px;border:1px solid rgba(205,164,222,.42);border-radius:8px 3px 8px 3px;color:#d5b4e3;background:rgba(89,48,107,.28);font:600 10px/1 Georgia,serif;transform:rotate(-3deg)}.eybf-record h3{margin:2px 0 6px;color:#dcbdea;font-size:12px;line-height:1.3;font-weight:650;letter-spacing:.13em}.eybf-record p{margin:0;color:var(--ink);font-size:14px;line-height:1.78;word-break:break-word;overflow-wrap:anywhere;white-space:pre-wrap}.eybf-action{background:linear-gradient(115deg,rgba(154,97,187,.13),rgba(255,255,255,.018) 55%)}.eybf-history{border-color:rgba(206,161,226,.27);background:linear-gradient(120deg,rgba(106,57,127,.18),rgba(255,255,255,.018) 62%)}.eybf-history p{font-size:14.5px;line-height:1.88}.eybf-keywords{position:relative;z-index:2;display:grid;grid-template-columns:auto minmax(0,1fr);align-items:start;gap:13px;margin-top:10px;padding:10px 13px;border-top:1px solid rgba(195,170,207,.16);border-bottom:1px solid rgba(195,170,207,.10)}.eybf-keywords span{color:#caa7d9;font-size:11px;letter-spacing:.12em;white-space:nowrap}.eybf-keywords p{margin:0;color:#eadcf0;font-size:13px;line-height:1.65;word-break:break-word}.eybf-foot{position:relative;z-index:2;display:flex;align-items:center;gap:10px;margin-top:12px;padding:0 4px;color:rgba(197,179,205,.62);font-size:10px;letter-spacing:.14em}.eybf-foot i{height:1px;flex:1;background:linear-gradient(90deg,rgba(154,97,187,.52),rgba(216,183,229,.15),transparent)}.eybf-trim{position:absolute;inset:0;z-index:1;pointer-events:none}.eybf-sigil{position:absolute;width:72px;height:15px;opacity:.68}.eybf-sigil::before{content:\"\";position:absolute;top:7px;left:0;width:100%;height:1px;background:linear-gradient(90deg,transparent,var(--plum) 32%,rgba(226,199,237,.24) 78%,transparent)}.eybf-sigil::after{content:\"\";position:absolute;top:3px;left:32px;width:8px;height:8px;border:1px solid rgba(225,197,237,.62);background:var(--plum-deep);transform:rotate(45deg)}.eybf-sigil-tr{top:-7px;right:38px}.eybf-sigil-bl{bottom:-7px;left:31px;transform:rotate(180deg)}.eybf-notch{position:absolute;width:18px;height:18px;opacity:.36}.eybf-notch-tl{top:10px;left:10px;border-top:1px solid var(--plum);border-left:1px solid var(--plum);border-radius:9px 0 0}.eybf-notch-br{right:10px;bottom:10px;border-right:1px solid var(--plum);border-bottom:1px solid var(--plum);border-radius:0 0 11px}@media(max-width:680px){.eybf-card{width:100%;padding:18px 14px 15px;border-radius:22px 10px 24px 12px}.eybf-head{min-height:60px;padding-right:2px}.eybf-heading h2{font-size:23px}.eybf-heading p{font-size:11px}.eybf-meta{grid-template-columns:1fr}.eybf-pair{grid-template-columns:1fr}.eybf-record{padding:11px}.eybf-record p{font-size:13px;line-height:1.74}.eybf-history p{font-size:13.5px;line-height:1.82}.eybf-keywords{grid-template-columns:1fr;gap:5px}.eybf-sigil-tr{right:24px}.eybf-sigil-bl{left:21px}}</style>",
