{
  "name": "eyon-history-workbench",
  "version": "0.14.26",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "webpack --config webpack.config.cjs && node scripts/enforce-jitless-build.mjs",
    "package:release": "pnpm build && node scripts/sync-manifest-hashes.mjs && node scripts/build-tavern-test-loader.mjs && node scripts/build-auto-update-loader.mjs",
    "test": "node --test tests/*.test.ts",
    "test:regex": "node scripts/verify-local-regex.mjs",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "lucide": "^0.468.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.105.4",
    "webpack-cli": "^6.0.1"
  },
  "engines": {
    "node": ">=22.18"
  }
}
